# PostgreSQL connection string.
# Local (docker compose up -d):
DATABASE_URL="postgresql://spt:spt@localhost:5432/spt?schema=public"

# 32+ byte secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="replace-me-with-at-least-32-characters-of-random-data"

# NODE_ENV is set by Next.js — do not put it here. The session cookie gets the
# Secure flag automatically when running a production build.
